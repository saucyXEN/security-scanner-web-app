# Copy to .env.local and fill in what you have. Everything is optional:
# file analysis, recon and PDF export work offline without any key.

# VirusTotal API v3 — 70+ antivirus engines for URLs and files.
# Free key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Shodan — OSINT host intelligence and deep search.
# Free key: https://account.shodan.io/
# Some endpoints (e.g. /shodan/host/search, /files/upload_url) need a paid plan.
SHODAN_API_KEY=

# Ollama — local AI analyst. Install: https://ollama.com/download
# Then: ollama serve && ollama pull llama3.2
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
